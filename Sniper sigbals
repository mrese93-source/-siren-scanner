# --- ניהול בסיס נתונים ---
def load_db():
    try:
        if os.path.exists(DB_FILE):
            with open(DB_FILE, "r", encoding="utf-8") as f:
                return json.load(f)
        return {"subscribers": {}, "pending": {}, "admin_id": None}
    except Exception as e:
        print(f"Load DB Error: {e}")
        return {"subscribers": {}, "pending": {}, "admin_id": None}

def save_db(db):
    try:
        with open(DB_FILE, "w", encoding="utf-8") as f:
            json.dump(db, f, indent=2, ensure_ascii=False)
    except Exception as e:
        print(f"Save DB Error: {e}")

# --- פונקציות עזר לטלגרם ---
def tg(method, data={}):
    try:
        r = requests.post(f"{BASE_URL}/{method}", json=data, timeout=10)
        return r.json()
    except Exception as e:
        print(f"TG Error: {e}")
        return {}

def send(chat_id, text, reply_markup=None):
    data = {"chat_id": chat_id, "text": text, "parse_mode": "HTML"}
    if reply_markup:
        data["reply_markup"] = reply_markup
    return tg("sendMessage", data)

def kick_user(user_id):
    tg("banChatMember", {"chat_id": CHANNEL_ID, "user_id": user_id})
    tg("unbanChatMember", {"chat_id": CHANNEL_ID, "user_id": user_id})

def create_invite():
    result = tg("createChatInviteLink", {
        "chat_id": CHANNEL_ID,
        "member_limit": 1,
        "expire_date": int(time.time()) + 3600
    })
    return result.get("result", {}).get("invite_link")

