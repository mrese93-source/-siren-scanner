```
# تشغيل فحص المنتهين في خيط منفصل
threading.Thread(target=check_expired, daemon=True).start()

while True:
    try:
        result = tg("getUpdates", {"offset": offset, "timeout": 30})
        updates = result.get("result", [])

        for update in updates:
            offset = update["update_id"] + 1

            # Callback (أزرار الأدمن)
            if "callback_query" in update:
                cb      = update["callback_query"]
                cb_id   = cb["id"]
                data    = cb.get("data", "")
                from_id = cb["from"]["id"]

                tg("answerCallbackQuery", {"callback_query_id": cb_id})

                if data == "subscribe":
                    handle_subscribe(from_id, cb["from"].get("first_name", ""))

                elif data.startswith("approve_"):
                    uid = int(data.split("_")[1])
                    ok  = approve_user(uid)
                    db  = load_db()
                    admin_id = db.get("admin_id")
                    if admin_id:
                        send(admin_id, "✅ Subscriber approved" if ok else "❌ Failed — check bot permissions")

                elif data.startswith("reject_"):
                    uid = int(data.split("_")[1])
                    reject_user(uid)
                    db  = load_db()
                    admin_id = db.get("admin_id")
                    if admin_id:
                        send(admin_id, "❌ Request rejected")

            # رسالة عادية
            elif "message" in update:
                msg      = update["message"]
                user_id  = msg["from"]["id"]
                username = msg["from"].get("username", "")
                fname    = msg["from"].get("first_name", "")
                text     = msg.get("text", "").strip()

                if not text:
                    continue

                db       = load_db()
                admin_id = db.get("admin_id")
                is_admin = (admin_id and user_id == admin_id)

                # أوامر الأدمن
                if text.startswith("/") and (is_admin or text == "/admin"):
                    handle_admin_cmd(user_id, text)

                # /start
                elif text == "/start":
                    handle_start(user_id, username, fname)

                # hash الصفقة (64 حرف hex)
                elif len(text) == 64 and all(c in "0123456789abcdefABCDEF" for c in text):
                    handle_hash(user_id, username, fname, text)

                # رسالة غير معروفة
                else:
                    send(user_id,
                        "للبدء اضغط /start\n"
                        "بعد الدفع أرسل hash الصفقة مباشرة"
                    )

    except Exception as e:
        print(f"Main loop error: {e}", flush=True)
        time.sleep(5)
```

