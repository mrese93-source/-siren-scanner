import os
import json
import time
from datetime import datetime, timedelta
import threading
import requests

BOT_TOKEN = os.environ.get("BOT_TOKEN")
CHANNEL_ID = -1003976387571

DB_FILE = "db.json"
BASE_URL = f"https://api.telegram.org/bot{BOT_TOKEN}"

def load_db():
    try:
        with open(DB_FILE, "r") as f:
            return json.load(f)
    except:
        return {"subs": {}, "pending": {}, "admin": None}

def save_db(db):
    with open(DB_FILE, "w") as f:
        json.dump(db, f)

def tg(method, data=None):
    try:
        return requests.post(f"{BASE_URL}/{method}", json=data or {}).json()
    except:
        return {}

def send(chat_id, text):
    tg("sendMessage", {
        "chat_id": chat_id,
        "text": text
    })

def main():
    offset = 0

    while True:
        res = tg("getUpdates", {"offset": offset})
        updates = res.get("result", [])

        for u in updates:
            offset = u["update_id"] + 1

            if "message" in u:
                msg = u["message"]
                uid = msg["from"]["id"]
                text = msg.get("text", "")

                if text == "/start":
                    send(uid, "Bot is working ✅")

if __name__ == "__main__":
    main()
