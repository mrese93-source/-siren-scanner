    if not pending:
        send(user_id, "No pending requests")
        return
    for uid, p in pending.items():
        user_link = f"@{p['username']}" if p.get('username') else p.get('first_name', uid)
        keyboard = {
            "inline_keyboard": [[
                {"text": "✅ Approve", "callback_data": f"approve_{uid}"},
                {"text": "❌ Reject",  "callback_data": f"reject_{uid}"}
            ]]
        }
        send(user_id,
            f"👤 {user_link}\n"
            f"🔗 <code>{p['tx_hash']}</code>\n"
            f"🕐 {p['timestamp'][:16]}",
            keyboard
        )
    return

if text == "/subs":
    subs = db["subscribers"]
    if not subs:
        send(user_id, "No active subscribers")
        return
    lines = ["👥 <b>Active Subscribers:</b>\n"]
    for uid, s in subs.items():
        exp  = datetime.fromisoformat(s["expires"])
        days = (exp - datetime.now()).days
        if days > 0:
            name = f"@{s['username']}" if s.get('username') else s.get('first_name', uid)
            lines.append(f"• {name} — {days} days left")
    send(user_id, "\n".join(lines))
    return
