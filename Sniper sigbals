def handle_hash(user_id, username, first_name, tx_hash):
    db = load_db()
    db["pending"][str(user_id)] = {
        "user_id": user_id,
        "username": username or "",
        "first_name": first_name or "",
        "tx_hash": tx_hash,
        "timestamp": datetime.now().isoformat()
    }
    save_db(db)

    send(user_id, 
