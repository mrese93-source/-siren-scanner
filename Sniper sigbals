def approve_user(user_id):
    db = load_db()
    pending = db["pending"].get(str(user_id))
    if not pending: return False

    invite = create_invite()
    if not invite: return False

    expires = (datetime.now() + timedelta(days=SUB_DAYS)).isoformat()
    db["subscribers"][str(user_id)] = {
        "user_id": user_id, "username": pending.get("username"),
        "expires": expires, "joined": datetime.now().isoformat()
    }
    if str(user_id) in db["pending"]: del db["pending"][str(user_id)]
    save_db(db)

    send(user_id, f"🎯 <b>Activated!</b>\n\n🔗 Your link: {invite}\n📅 Expires: {expires[:10]}")
    return True

# --- الفحص الدوري لانتهاء الاشتراك ---
def check_expired():
    while True:
        try:
            db = load_db()
            now = datetime.now()
            expired = [uid for uid, sub in db["subscribers"].items() if datetime.fromisoformat(sub["expires"]) < now]
            for uid in expired:
                kick_user(int(uid))
                send(int(uid), "⚠️ Subscription expired. /start to renew.")
                del db["subscribers"][uid]
            if expired: save_db(db)
        except: pass
        time.sleep(3600)

