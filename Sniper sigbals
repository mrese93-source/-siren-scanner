    db = load_db()
    if text == "/admin":
        db["admin_id"] = user_id
        save_db(db)
        send(user_id, "✅ You are now registered as admin")
        return

    if text == "/stats":
        subs = len(db["subscribers"])
        pending = len(db["pending"])
        active = sum(1 for s in db["subscribers"].values() if datetime.fromisoformat(s["expires"]) > datetime.now())
        send(user_id, f"📊 <b>Stats</b>\n\n✅ Active: {active}\n⏳ Pending: {pending}")
        return

# --- לופים של המערכת ---
def check_expired():
    while True:
        try:
            db = load_db()
            now = datetime.now()
            expired = []
            for uid, sub in db["subscribers"].items():
                if datetime.fromisoformat(sub["expires"]) < now:
                    expired.append(uid)
            
            for uid in expired:
                kick_user(int(uid))
                send(int(uid), "⚠️ Your subscription has expired. Send /start to renew.")
                del db["subscribers"][uid]
            
            if expired:
                save_db(db)
        except Exception as e:
            print(f"Expiry error: {e}")
        time.sleep(3600)

def main():
    print("🎯 Sniper Signals Bot — Started")
    offset = 0
    threading.Thread(target=check_expired, daemon=True).start()

    while True:
        try:
            result = tg("getUpdates", {"offset": offset, "timeout": 30})
            updates = result.get("result", [])

            for update in updates:
                offset = update["update_id"] + 1

                if "callback_query" in update:
                    cb = update["callback_query"]
                    data = cb.get("data", "")
                    from_id = cb["from"]["id"]
                    tg("answerCallbackQuery", {"callback_query_id": cb["id"]})

                    if data == "subscribe":
                        handle_subscribe(from_id, cb["from"].get("first_name", ""))
                    elif data.startswith("approve_"):
                        uid = int(data.split("_")[1])
                        approve_user(uid)
                    elif data.startswith("reject_"):
                        uid = int(data.split("_")[1])
                        reject_user(uid)

                elif "message" in update:
                    msg = update["message"]
                    user_id = msg["from"]["id"]
                    text = msg.get("text", "").strip()
                    if not text: continue

                    db = load_db()
                    is_admin = (db.get("admin_id") == user_id)

                    if text.startswith("/") and (is_admin or text == "/admin"):
                        handle_admin_cmd(user_id, text)
                    elif text == "/start":
                        handle_start(user_id, msg["from"].get("username"), msg["from"].get("first_name"))
                    elif len(text) == 64: # فحص بسيط لطول الهاش
                        handle_hash(user_id, msg["from"].get("username"), msg["from"].get("first_name"), text)

        except Exception as e:
            print(f"Main loop error: {e}")
            time.sleep(5)

if __name__ == "__main__":
    main()
