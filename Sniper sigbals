import os
import json
import time
import threading
from datetime import datetime, timedelta

import requests

# =========================
# إعدادات
# =========================

BOT_TOKEN   = "PUT_YOUR_BOT_TOKEN_HERE"
CHANNEL_ID  = -1003976387571
PRICE_USD   = 25
SUB_DAYS    = 30

WALLET_USDT = "TXj3JCr6ZbM8Tnq8WqLubL81g4mwAw5pUr"

DB_FILE     = "subscribers.json"
BASE_URL    = f"https://api.telegram.org/bot{BOT_TOKEN}"

# =========================
# DB
# =========================

def load_db():
    try:
        with open(DB_FILE, "r") as f:
            return json.load(f)
    except:
        return {"subscribers": {}, "pending": {}, "admin_id": None}

def save_db(db):
    with open(DB_FILE, "w") as f:
        json.dump(db, f, indent=2)

# =========================
# Telegram
# =========================

def tg(method, data=None):
    try:
        r = requests.post(f"{BASE_URL}/{method}", json=data or {}, timeout=10)
        return r.json()
    except Exception as e:
        print("TG ERROR:", e)
        return {}

def send(chat_id, text, keyboard=None):
    data = {
        "chat_id": chat_id,
        "text": text,
        "parse_mode": "HTML"
    }
    if keyboard:
        data["reply_markup"] = keyboard
    return tg("sendMessage", data)

def kick_user(user_id):
    tg("banChatMember", {"chat_id": CHANNEL_ID, "user_id": user_id})
    tg("unbanChatMember", {"chat_id": CHANNEL_ID, "user_id": user_id})

def create_invite():
    res = tg("createChatInviteLink", {
        "chat_id": CHANNEL_ID,
        "member_limit": 1,
        "expire_date": int(time.time()) + 3600
    })
    return res.get("result", {}).get("invite_link")

# =========================
# Handlers
# =========================

def handle_start(user_id, username, fname):
    db = load_db()

    sub = db["subscribers"].get(str(user_id))
    if sub:
        exp = datetime.fromisoformat(sub["expires"])
        if exp > datetime.now():
            days = (exp - datetime.now()).days
            send(user_id, f"✅ Active — {days} days left")
            return

    keyboard = {
        "inline_keyboard": [[
            {"text": "💳 Subscribe", "callback_data": "subscribe"}
        ]]
    }

    send(user_id,
        f"🎯 <b>Sniper Signals</b>\n\n"
        f"💰 ${PRICE_USD} / month\n"
        f"USDT TRC20\n\n"
        f"Click below to subscribe",
        keyboard
    )

def handle_subscribe(user_id):
    send(user_id,
        f"💳 Send <b>${PRICE_USD} USDT</b> (TRC20)\n\n"
        f"<code>{WALLET_USDT}</code>\n\n"
        f"Then send TX HASH"
    )

def handle_hash(user_id, username, fname, tx):
    db = load_db()

    db["pending"][str(user_id)] = {
        "username": username,
        "fname": fname,
        "tx": tx,
        "time": datetime.now().isoformat()
    }

    save_db(db)

    send(user_id, "⏳ Waiting for approval...")

    admin = db.get("admin_id")
    if admin:
        keyboard = {
            "inline_keyboard": [[
                {"text": "✅ Approve", "callback_data": f"approve_{user_id}"},
                {"text": "❌ Reject",  "callback_data": f"reject_{user_id}"}
            ]]
        }

        send(admin,
            f"User: @{username}\nTX:\n<code>{tx}</code>",
            keyboard
        )

def approve_user(uid):
    db = load_db()

    p = db["pending"].get(str(uid))
    if not p:
        return False

    invite = create_invite()
    if not invite:
        return False

    exp = (datetime.now() + timedelta(days=SUB_DAYS)).isoformat()

    db["subscribers"][str(uid)] = {
        "expires": exp
    }

    del db["pending"][str(uid)]
    save_db(db)

    send(uid, f"✅ Approved\n{invite}")
    return True

def reject_user(uid):
    db = load_db()

    if str(uid) in db["pending"]:
        del db["pending"][str(uid)]
        save_db(db)

    send(uid, "❌ Payment rejected")

def handle_admin(user_id, text):
    db = load_db()

    if text == "/admin":
        db["admin_id"] = user_id
        save_db(db)
        send(user_id, "✅ Admin set")

# =========================
# Expiry
# =========================

def check_expired():
    while True:
        db = load_db()
        now = datetime.now()

        for uid, sub in list(db["subscribers"].items()):
            if datetime.fromisoformat(sub["expires"]) < now:
                kick_user(int(uid))
                del db["subscribers"][uid]

        save_db(db)
        time.sleep(3600)

# =========================
# Main
# =========================

def main():
    offset = 0

    threading.Thread(target=check_expired, daemon=True).start()

    while True:
        res = tg("getUpdates", {"offset": offset})
        updates = res.get("result", [])

        for u in updates:
            offset = u["update_id"] + 1

            if "callback_query" in u:
                data = u["callback_query"]["data"]
                uid  = u["callback_query"]["from"]["id"]

                tg("answerCallbackQuery", {
                    "callback_query_id": u["callback_query"]["id"]
                })

                if data == "subscribe":
                    handle_subscribe(uid)

                elif data.startswith("approve_"):
                    approve_user(int(data.split("_")[1]))

                elif data.startswith("reject_"):
                    reject_user(int(data.split("_")[1]))

            elif "message" in u:
                msg = u["message"]
                uid = msg["from"]["id"]
                text = msg.get("text", "")

                if text == "/start":
                    handle_start(uid, "", "")

                elif text == "/admin":
                    handle_admin(uid, text)

                elif len(text) == 64:
                    handle_hash(uid, "", "", text)

if __name__ == "__main__":
    main()
