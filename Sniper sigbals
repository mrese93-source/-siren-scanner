import requests
import time

# --- الإعدادات (ضع بياناتك هنا) ---
TOKEN        = "8640215686:AAHvQDoFMxX8KyKLuGTcAJ5D4xf0DBWFnDA"
MY_WALLET    = "TXj3JCr6ZbM8Tnq8WqLubL81g4mwAw5pUr"
CHANNEL_ID   = -1003976387571
REQUIRED_USD = 25  # المبلغ المطلوب بالضبط

URL = f"https://api.telegram.org/bot{TOKEN}/"

# لمنع الاحتيال: سنخزن العمليات التي تم تفعيلها سابقاً في قائمة (يفضل لاحقاً وضعها في ملف)
USED_TXS = []

def check_tron_scan(tx_id):
    """الفحص الآلي للعملية عبر شبكة ترون"""
    try:
        # فحص العملية عبر API مجاني (TronGrid)
        api_url = f"https://api.trongrid.io/v1/transactions/{tx_id}/events"
        response = requests.get(api_url, timeout=10).json()
        
        if response.get('success') and response.get('data'):
            for event in response['data']:
                if event.get('event_name') == 'Transfer':
                    result = event.get('result', {})
                    # التأكد من المحفظة المستلمة والمبلغ (USDT يحتوي على 6 أصفار عشرياً)
                    to_address = result.get('to')
                    amount = int(result.get('value')) / 1_000_000
                    
                    if to_address == MY_WALLET and amount >= REQUIRED_USD:
                        return True
        return False
    except:
        return False

def tg_call(method, data):
    try: return requests.post(URL + method, json=data, timeout=15).json()
    except: return None

def main():
    print("🤖 Automated Bot is Live...")
    offset = 0
    while True:
        updates = tg_call("getUpdates", {"offset": offset, "timeout": 20})
        if updates and "result" in updates:
            for update in updates["result"]:
                offset = update["update_id"] + 1
                if "message" in update:
                    msg = update["message"]
                    uid = msg["chat"]["id"]
                    text = msg.get("text", "").strip()

                    if text == "/start":
                        tg_call("sendMessage", {"chat_id": uid, "text": f"أهلاً بك!\nللاشتراك، أرسل {REQUIRED_USD}$ USDT (TRC20) للمحفظة:\n`{MY_WALLET}`\n\nثم أرسل الـ TXID هنا للفحص الآلي.", "parse_mode": "Markdown"})
                    
                    elif len(text) == 64:
                        if text in USED_TXS:
                            tg_call("sendMessage", {"chat_id": uid, "text": "❌ هذا الرمز تم استخدامه مسبقاً!"})
                        else:
                            tg_call("sendMessage", {"chat_id": uid, "text": "🔍 جاري فحص العملية على البلوكشين... انتظر لحظة."})
                            if check_tron_scan(text):
                                # توليد رابط لمرة واحدة فقط
                                link_res = tg_call("createChatInviteLink", {"chat_id": CHANNEL_ID, "member_limit": 1})
                                invite_link = link_res.get("result", {}).get("invite_link")
                                
                                USED_TXS.append(text) # تسجيل العملية كـ "مستخدمة" لمنع النصب
                                tg_call("sendMessage", {"chat_id": uid, "text": f"✅ تم التأكد من الدفع! إليك رابط القناة (صالح لشخص واحد فقط):\n{invite_link}"})
                            else:
                                tg_call("sendMessage", {"chat_id": uid, "text": "❌ لم نجد عملية دفع مطابقة. تأكد من إرسال المبلغ الصحيح للمحفظة الصحيحة."})
        time.sleep(1)

if __name__ == "__main__":
    main()
