def approve_user(user_id):
    db = load_db()
    pending = db["pending"].get(str(user_id))
    if not pending:
        return False

    invite = create_invite()
    if not invite:
        return False

    expires = (datetime.now() + timedelta(days=SUB_DAYS)).isoformat()
    db["subscribers"][str(user_id)] = {
        "user_id": user_id,
        "username": pending.get("username", ""),
        "first_name": pending.get("first_name", ""),
        "expires": expires,
        "tx_hash": pending.get("tx_hash", ""),
        "joined": datetime.now().isoformat()
    }

    if str(user_id) in db["pending"]:
        del db["pending"][str(user_id)]
    save_db(db)

    send(user_id,
        f"🎯 <b>Subscription Activated!</b>\n\n"
        f"Welcome to Sniper Signals 🐋\n\n"
        f"🔗 Your private channel link:\n{invite}\n\n"
        f"⚠️ This link is valid for one use only\n"
        f"📅 Subscription valid until: {expires[:10]}"
    )
    return True

def reject_user(user_id):
    db = load_db()
    if str(user_id) in db["pending"]:
        del db["pending"][str(user_id)]
        save_db(db)

    send(user_id,
        f"❌ Payment could not be verified\n\n"
        f"Please make sure:\n"
        f"• You sent the correct amount (${PRICE_USD} USDT)\n"
        f"• You used the TRC20 network\n"
        f"• You sent the correct transaction hash\n\n"
        f"For help, contact support"
    )

