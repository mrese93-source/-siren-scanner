    if sub:
        exp = datetime.fromisoformat(sub["expires"])
        remaining = (exp - datetime.now()).days
        if remaining > 0:
            send(user_id, f"✅ Welcome back, {first_name}!\nYour subscription is active — expires in <b>{remaining} days</b>")
            active = True

    if not active:
