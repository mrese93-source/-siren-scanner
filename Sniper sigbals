def handle_hash(user_id, username, first_name, tx_hash):
    db = load_db()
    db["pending"][str(user_id)] = {
        "user_id": user_id, "username": username or "",
        "first_name": first_name or "", "tx_hash": tx_hash,
        "timestamp": datetime.now().isoformat()
    }
    save_db(db)
    send(user_id, "⏳ Hash received! Verification in progress...")

    admin_id = db.get("admin_id")
    if admin_id:
        keyboard = {"inline_keyboard": [[
            {"text": "✅ Approve", "callback_data": f"approve_{user_id}"},
            {"text": "❌ Reject", "callback_data": f"reject_{user_id}"}
        ]]}
        send(admin_id, f"🔔 <b>New Request</b>\nUser: {first_name}\nHash: <code>{tx_hash}</code>", keyboard)

